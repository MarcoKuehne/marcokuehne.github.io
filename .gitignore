# ---- R session artifacts -------------------------------------------------
.Rproj.user
.Rhistory
.RData
.Rdata
.Ruserdata
.Renviron
.httr-oauth
Rplots.pdf

# ---- bookdown / knitr build artifacts ------------------------------------
# All of these are regenerated on every render.
# The published site lives in docs/ and IS tracked - every rule below is
# anchored with a leading slash so it applies to the repository root only
# and can never reach inside docs/.
/_book/
/_bookdown_files/
/_main.Rmd
/_main.html
/_main_files/
/*_files/
/tinytable_assets/
/libs/

# intermediate markdown left behind by knitting
/*.md
!/README.md
/*.knit.md
/*.utf8.md

# bookdown's cross-reference cache, named after book_filename in _bookdown.yml
/*.rds

# ---- editors / OS --------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/

# ---- local-only folders --------------------------------------------------
/Backup
/Backup_Chapters
/SOEPTeaching
/DCL

# originals kept by scripts/optimize-images.R
/images/_originals/
